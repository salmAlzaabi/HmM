// يجلب بيانات الأعداد والأيقونة لكل سيرفر عبر رابط الدعوة العام - بدون بوت أو توكن.
// يعمل من GitHub Actions (Node 18+ فيه fetch مدمج).

import fs from "node:fs/promises";
import path from "node:path";
import { fileURLToPath } from "node:url";

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const SERVERS_PATH = path.join(__dirname, "..", "data", "servers.json");
const LIVE_PATH = path.join(__dirname, "..", "data", "live.json");

const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

async function fetchInvite(inviteCode) {
  const url = `https://discord.com/api/v10/invites/${encodeURIComponent(
    inviteCode
  )}?with_counts=true&with_expiration=true`;

  const res = await fetch(url, {
    headers: {
      "User-Agent": "HmM-Network-Status-Fetcher/1.0 (+https://github.com)",
    },
  });

  if (!res.ok) {
    throw new Error(`HTTP ${res.status}`);
  }

  return res.json();
}

async function main() {
  const raw = await fs.readFile(SERVERS_PATH, "utf-8");
  const servers = JSON.parse(raw);

  const result = {
    generatedAt: new Date().toISOString(),
    servers: {},
  };

  for (const server of servers) {
    if (!server.inviteCode || server.inviteCode.includes("ضع-كود-الدعوة")) {
      result.servers[server.id] = { ok: false, error: "no-invite-configured" };
      continue;
    }

    try {
      const data = await fetchInvite(server.inviteCode);
      const guild = data.guild || {};
      const icon = guild.icon
        ? `https://cdn.discordapp.com/icons/${guild.id}/${guild.icon}.${
            guild.icon.startsWith("a_") ? "gif" : "png"
          }`
        : null;

      result.servers[server.id] = {
        ok: true,
        name: guild.name ?? null,
        icon,
        memberCount: data.approximate_member_count ?? null,
        presenceCount: data.approximate_presence_count ?? null,
      };
    } catch (err) {
      result.servers[server.id] = {
        ok: false,
        error: String(err && err.message ? err.message : err),
      };
    }

    // مهلة بسيطة بين الطلبات تجنّباً لأي تحديد معدل (rate limit)
    await sleep(500);
  }

  await fs.writeFile(LIVE_PATH, JSON.stringify(result, null, 2) + "\n", "utf-8");
  console.log("تم تحديث data/live.json");
}

main().catch((err) => {
  console.error(err);
  process.exit(1);
});
